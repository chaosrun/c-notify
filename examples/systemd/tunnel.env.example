# SSH target for the dedicated reverse tunnel.
# This can be a host alias from ~/.ssh/config or a user@host string.
C_NOTIFY_SSH_TARGET=my-remote

# Remote bind address and port exposed on the remote machine.
C_NOTIFY_REMOTE_BIND_ADDRESS=127.0.0.1
C_NOTIFY_REMOTE_PORT=38765

# Local c-notify serve port on the playback machine.
C_NOTIFY_LOCAL_PORT=38765
