{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/c-notify/c-notify.py relay --tool codex --endpoint http://127.0.0.1:38765",
            "timeout": 10,
            "statusMessage": "Forwarding c-notify session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/c-notify/c-notify.py relay --tool codex --endpoint http://127.0.0.1:38765",
            "timeout": 10,
            "statusMessage": "Forwarding c-notify task-acknowledge"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/c-notify/c-notify.py relay --tool codex --endpoint http://127.0.0.1:38765",
            "timeout": 10,
            "statusMessage": "Forwarding c-notify permission-needed"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /ABSOLUTE/PATH/TO/c-notify/c-notify.py relay --tool codex --endpoint http://127.0.0.1:38765",
            "timeout": 10,
            "statusMessage": "Forwarding c-notify context-compact"
          }
        ]
      }
    ]
  }
}
